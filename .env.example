# ===========================================
# HEALTH & FITNESS APP - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and fill in actual values
# NEVER commit .env to version control

# ===========================================
# BACKEND (NestJS)
# ===========================================

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/health_app
DATABASE_POOL_SIZE=20
DATABASE_SSL=false

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_TLS=false

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=1d
JWT_REFRESH_EXPIRATION=7d

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

APPLE_CLIENT_ID=your-apple-oauth-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_PATH=./secrets/apple-auth-key.p8

# API Keys
RAPIDAPI_KEY=your-rapidapi-key-for-exercisedb
NEWSAPI_KEY=your-newsapi-org-key
PUBMED_API_KEY=your-ncbi-pubmed-api-key
ZENQUOTES_API_KEY=optional-zenquotes-key

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:8080,http://localhost:3000

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DESTINATION=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# MOBILE APP (Flutter)
# ===========================================

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# API Endpoints
API_BASE_URL=http://localhost:3000
ML_SERVICE_URL=http://localhost:8000

# OAuth Mobile
GOOGLE_OAUTH_CLIENT_ID_IOS=your-ios-google-client-id
GOOGLE_OAUTH_CLIENT_ID_ANDROID=your-android-google-client-id
APPLE_OAUTH_CLIENT_ID=your-apple-client-id

# Firebase (for push notifications)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID_IOS=your-ios-app-id
FIREBASE_APP_ID_ANDROID=your-android-app-id

# Analytics
MIXPANEL_TOKEN=your-mixpanel-token
SENTRY_DSN=your-sentry-dsn

# ===========================================
# ML SERVICE (Python FastAPI)
# ===========================================

# Database (Read Replica recommended)
ML_DATABASE_URL=postgresql://user:password@localhost:5432/health_app

# Model Paths
MODEL_PATH=/app/models
PRETRAINED_MODEL_PATH=/app/models/pretrained

# MediaPipe
MEDIAPIPE_MODEL_PATH=/app/models/mediapipe

# ML Configuration
BATCH_SIZE=32
MAX_WORKERS=4
ENABLE_GPU=false

# Caching
ML_CACHE_TTL=3600

# ===========================================
# DEPLOYMENT (Production Only)
# ===========================================

# Railway
RAILWAY_ENVIRONMENT=production

# Supabase
SUPABASE_DB_PASSWORD=your-production-db-password
SUPABASE_JWT_SECRET=your-production-jwt-secret

# Upstash Redis
UPSTASH_REDIS_URL=your-upstash-redis-rest-url
UPSTASH_REDIS_TOKEN=your-upstash-token

# CloudFlare
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_R2_BUCKET=health-app-assets
CLOUDFLARE_R2_ACCESS_KEY=your-r2-access-key
CLOUDFLARE_R2_SECRET_KEY=your-r2-secret-key

# Monitoring
SENTRY_DSN_BACKEND=your-backend-sentry-dsn
SENTRY_DSN_MOBILE=your-mobile-sentry-dsn
MIXPANEL_TOKEN_PRODUCTION=your-production-mixpanel-token

# Email (SendGrid/Mailgun)
EMAIL_SERVICE=sendgrid
EMAIL_API_KEY=your-email-service-api-key
EMAIL_FROM=noreply@healthapp.com

# Stripe (Payment Processing)
STRIPE_PUBLISHABLE_KEY=pk_live_your_key
STRIPE_SECRET_KEY=sk_live_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# App Store / Play Store
APP_STORE_SHARED_SECRET=your-app-store-shared-secret
PLAY_STORE_SERVICE_ACCOUNT_KEY=./secrets/play-store-key.json

# ===========================================
# FEATURE FLAGS
# ===========================================

ENABLE_SOCIAL_FEATURES=true
ENABLE_POSE_DETECTION=true
ENABLE_DRUG_INTERACTIONS=true
ENABLE_ML_RECOMMENDATIONS=true
ENABLE_PREMIUM_FEATURES=true

# ===========================================
# SECURITY
# ===========================================

# Encryption
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-for-aes-256
ENCRYPTION_ALGORITHM=aes-256-gcm

# Session
SESSION_SECRET=your-session-secret-key

# CORS
ALLOWED_ORIGINS=https://healthapp.com,https://app.healthapp.com

# CSP (Content Security Policy)
CSP_DIRECTIVES=default-src 'self'; script-src 'self' 'unsafe-inline';

# ===========================================
# LOGGING
# ===========================================

LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_REQUEST_LOGGING=true

# ===========================================
# NOTES
# ===========================================
# - Generate JWT_SECRET: openssl rand -hex 32
# - Generate ENCRYPTION_KEY: openssl rand -hex 32
# - For production, use environment-specific secrets management
# - Rotate secrets every 90 days
# - Use different keys for dev/staging/production
