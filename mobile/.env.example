# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# API Endpoints
API_BASE_URL=http://localhost:3000
ML_SERVICE_URL=http://localhost:8000

# OAuth
GOOGLE_OAUTH_CLIENT_ID_IOS=your-ios-client-id
GOOGLE_OAUTH_CLIENT_ID_ANDROID=your-android-client-id
APPLE_OAUTH_CLIENT_ID=your-apple-client-id

# Firebase
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_APP_ID_IOS=your-ios-app-id
FIREBASE_APP_ID_ANDROID=your-android-app-id
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_PROJECT_ID=your-project-id

# Analytics
MIXPANEL_TOKEN=your-mixpanel-token
SENTRY_DSN=your-sentry-dsn

# Feature Flags
ENABLE_SOCIAL_FEATURES=true
ENABLE_POSE_DETECTION=false
ENABLE_ML_RECOMMENDATIONS=true
